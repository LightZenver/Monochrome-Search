<Application
    x:Class="Monochrome.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="MonoBgColor">#050505</Color>
            <Color x:Key="MonoSurface">#0d0d0d</Color>
            <Color x:Key="MonoCard">#161616</Color>
            <Color x:Key="MonoLine">#2a2a2a</Color>
            <Color x:Key="MonoFg">#f2f2f2</Color>
            <Color x:Key="MonoMut">#8a8a8a</Color>

            <SolidColorBrush x:Key="MonoBg" Color="{StaticResource MonoBgColor}" />
            <SolidColorBrush x:Key="MonoSurfaceBr" Color="{StaticResource MonoSurface}" />
            <SolidColorBrush x:Key="MonoCardBr" Color="{StaticResource MonoCard}" />
            <SolidColorBrush x:Key="MonoLineBr" Color="{StaticResource MonoLine}" />
            <SolidColorBrush x:Key="MonoFgBr" Color="{StaticResource MonoFg}" />
            <SolidColorBrush x:Key="MonoMutBr" Color="{StaticResource MonoMut}" />
            <SolidColorBrush x:Key="MonoInk" Color="#000000" />

            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource MonoFg}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource MonoLine}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource MonoMut}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource MonoCard}" />

            <x:Double x:Key="TextControlThemeMinHeight">46</x:Double>
            <Thickness x:Key="TextControlThemePadding">14,8,14,8</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
